PORT=5000

# Local: either one URL or separate fields
DATABASE_URL=postgres://postgres:your_password@localhost:5432/ecommerce_admin
DB_NAME=ecommerce_admin
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Railway: add DATABASE_URL from Postgres service (Variables → Reference), not .env file
# Use DATABASE_PUBLIC_URL only if private networking is not linked

JWT_SECRET=change_this_jwt_secret
SESSION_SECRET=change_this_session_secret
COOKIE_PASSWORD=change_this_cookie_secret
